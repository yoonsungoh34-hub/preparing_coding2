# 인덱스 에러를 원천 차단하기 위해 101 x 101 크기의 넉넉한 격자판을 만듭니다.
mp = [[0 for _ in range(101)] for _ in range(101)]

for _ in range(n):
    l, d, x, y = map(int, input().split())
    
    # 막대 길이만큼 반복하며 격자판 채우기
    for j in range(l):
        if d == 0:
            # 가로 방향: x(세로 위치)는 고정, y(가로 위치)가 j만큼 증가
            mp[x][y + j] = 1
        else:
            # 세로 방향: x(세로 위치)가 j만큼 증가, y(가로 위치)는 고정
            mp[x + j][y] = 1

# 출력할 때는 정확히 문제에서 요구한 세로(h), 가로(w) 크기만큼만 출력합니다.
for i in range(1, h + 1):
    for j in range(1, w + 1):
        print(mp[i][j], end=' ')
    print()


#무지 먹방 라이브 
def solution(food_times, k):
    # 예외 처리: 매번 max를 구하지 말고, 처음 딱 한 번 전체 합을 구해서 검사!
    if sum(food_times) <= k:
        return -1
    
    index = 0
    length = len(food_times)
    
    # k초 동안 정직하게 돌기
    while k > 0:
        if food_times[index] > 0:
            food_times[index] -= 1
            k -= 1
            index = (index + 1) % length # 한 칸 전진 (끝에 도달하면 0으로 래핑)
        else:
            index = (index + 1) % length # 음수가 0이면 먹지 않고 그냥 칸만 전진
            
    # ⚠️ 핵심: k가 0이 되어 루프를 빠져나온 후, 
    # 현재 가리키는 index의 음수가 하필 '0(이미 다 먹은 음식)'일 수 있습니다.
    # 그럴 경우, 아직 남아있는 다음 음식을 찾을 때까지 인덱스를 계속 넘겨주어야 합니다.
    while food_times[index] == 0:
        index = (index + 1) % length
        
    return index + 1
    
